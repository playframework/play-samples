#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sample_path="$(pwd)"
sample_path="${sample_path#$repo_root/}"

sbt_bin="${SBT_BIN:-sbt}"
# Keep each sbt version in its own JVM instead of reconnecting to a previous lane's server.
sbt_process_args=(--server --no-server --batch)
run_sbt1="${RUN_SBT1_TESTS:-true}"
sbt1_version="${MATRIX_SBT1:-1.13.0}"
sbt2_version="${MATRIX_SBT2:-2.1.0-M2}"
run_sbt2="${RUN_SBT2_TESTS:-true}"

sbt2_blacklist=(
    # https://github.com/gatling/gatling-sbt-plugin not published for sbt 2
    "scala/rest-api"
    "java/rest-api"
     # https://github.com/tototoshi/sbt-slick-codegen/pull/103
     "scala/isolated-slick"
)

skip_sbt2="false"
for blacklisted_sample in "${sbt2_blacklist[@]}"; do
    if [[ "$sample_path" == "$blacklisted_sample" ]]; then
        skip_sbt2="true"
        break
    fi
done

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 <sbt-args...>"
    exit 1
fi

if [[ "$run_sbt1" == "true" ]]; then
    sbt1_args=()
    first_arg=true
    for arg in "$@"; do
        if [[ "$first_arg" != "true" && "$arg" != \;* ]]; then
            arg=";$arg"
        fi
        sbt1_args+=("$arg")
        first_arg=false
    done
    echo "+-----------------------------+"
    echo "| Executing tests using sbt 1 |"
    echo "+-----------------------------+"
    "$sbt_bin" "${sbt_process_args[@]}" -Dsbt.version="$sbt1_version" "${sbt1_args[@]}"
fi

if [[ "$run_sbt2" == "true" && "$skip_sbt2" != "true" ]]; then
    sbt2_args=()
    first_arg=true
    for arg in "$@"; do
        # In sbt 2, `test` is the incremental `testQuick`; CI needs the full suite.
        if [[ "$arg" == "test" ]]; then
            arg=testFull
        fi
        # sbt 2 joins command arguments with spaces, so delimit each command
        # explicitly rather than relying on sbt 1's CLI behavior.
        if [[ "$first_arg" != "true" && "$arg" != \;* ]]; then
            arg=";$arg"
        fi
        sbt2_args+=("$arg")
        first_arg=false
    done
    echo "+--------------------------------------+"
    echo "| Executing tests using sbt $sbt2_version |"
    echo "+--------------------------------------+"
    "$sbt_bin" "${sbt_process_args[@]}" -Dsbt.version="$sbt2_version" "${sbt2_args[@]}"
elif [[ "$run_sbt2" == "true" && "$skip_sbt2" == "true" ]]; then
    echo "Skipping sbt $sbt2_version for blacklisted sample: $sample_path"
fi
